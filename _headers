# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
#
# CACHING CONTRACT (deploy integrity): HTML pages must never be long-cached.
# Cloudflare Pages serves HTML with `max-age=0, must-revalidate` and
# cf-cache-status: DYNAMIC by default — do not add a Cache-Control for HTML
# routes here, and never add a zone-level "Cache Everything" rule for this
# site. Only fingerprinted/cache-busted assets below get long max-age.
# The post-deploy smoke test (.github/workflows/smoke-test.yml) fails loudly
# if any route serves a stale build.
# SECURITY HEADERS (apply to every route).
#
# HSTS: force HTTPS for a year, incl. subdomains. `preload` is SET here but NOT
# yet submitted — preloading is a one-way commitment (browsers hard-fail HTTP for
# the whole apex + all subdomains). Submit at https://hstspreload.org ONLY after
# confirming every subdomain serves HTTPS. Until submitted, the token is inert.
#
# Content-Security-Policy is now ENFORCED (audited 2026-07: every external
# script/style/font/connect/form target on the site is allowed by the policy;
# see the source map below). The matching Report-Only source rules stay for ONE more
# release as a canary — if the console ever shows a report-only violation the
# enforced header is blocking the same thing; revert the enforced line to
# Report-Only first, fix, then re-enforce. Drop the Report-Only line next release.
# CSP source map (one policy, served on /*):
#   default-src 'self'        — baseline: same-origin only unless overridden below
#   base-uri 'none'           — no <base> tag is used anywhere; forbid injection of one
#   object-src 'none'         — no <object>/<embed>/<applet>
#   frame-ancestors 'self'    — mirrors X-Frame-Options: SAMEORIGIN
#   frame-src https://calendly.com — the /book/ inline scheduler (the site's
#                               only iframe; direct embed, no widget.js)
#   script-src 'self' 'unsafe-inline' https://plausible.io https://bat.bing.net https://bat.bing.com
#                             — 'self': /js/*.js + Cloudflare /cdn-cgi/ email-decode;
#                               'unsafe-inline': inline init blocks + onclick="window.print()";
#                               plausible.io: analytics loader;
#                               bat.bing.net/.com: Microsoft Ads UET (bat.js —
#                               loaded from js/analytics.js, production host only;
#                               .net is the current CDN host, .com the older one
#                               bat.js may still chain-load from)
#   style-src 'self' 'unsafe-inline'
#                             — 'self': styles.css; 'unsafe-inline': inline style=
#                               attrs + <style> blocks (fonts self-hosted, no CDN CSS)
#   img-src 'self' data: https://bat.bing.net https://bat.bing.com
#                             — 'self': og-image/icons/content; data:: SVG film-grain
#                               in styles.css, inline SVG icons, SVG favicon;
#                               bat.bing.*: UET pixel-GET conversion beacons
#   font-src 'self'           — self-hosted subsetted woff2 in /fonts/
#   connect-src 'self' https://plausible.io https://formspree.io https://bat.bing.net https://bat.bing.com
#                             — 'self': /api/book-assessment + /blog-data/*.json;
#                               plausible.io: event beacons; formspree.io: careers form
#                               (api.resend.com is server-side in the Pages Function, not here);
#                               bat.bing.*: UET fetch/sendBeacon conversion beacons
#                               NOTE: if Microsoft's Clarity integration is ever
#                               switched on for UET tag 343267453, bat.js will try
#                               to load *.clarity.ms and this CSP will block it —
#                               deliberate; add the origin only if that is wanted
#   form-action 'self'
#                             — 'self': same-origin forms
#   upgrade-insecure-requests — enforced policy only; invalid in report-only
#
# Report-only mirrors the enforced source rules, but omits the enforcement-only
# upgrade-insecure-requests directive. To capture
# violations centrally, add a `report-to` directive + a `Report-To` header endpoint.
# Dropping 'unsafe-inline' (nonces or hashes) would require restructuring: the
# pages carry inline <script>/<style> blocks, style= attrs, and onclick handlers
# by design, and static _headers cannot mint per-request nonces (that needs a
# Worker/Function, or build-time hashing of every inline block). Not planned.
# The AI-Ready Score app is reverse-proxied from Vercel at /score/* and /s/*
# (functions/…). It ships standalone with its own scripts, styles, and security
# headers, so detach the main site's CSP + frame rules here — otherwise
# default-src 'self' and the frame rules would block the app.
/score
  ! Content-Security-Policy
  ! Content-Security-Policy-Report-Only
  ! X-Frame-Options
/score/*
  ! Content-Security-Policy
  ! Content-Security-Policy-Report-Only
  ! X-Frame-Options
/s/*
  ! Content-Security-Policy
  ! Content-Security-Policy-Report-Only
  ! X-Frame-Options

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; frame-src https://calendly.com; script-src 'self' 'unsafe-inline' https://plausible.io https://bat.bing.net https://bat.bing.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://bat.bing.net https://bat.bing.com; font-src 'self'; connect-src 'self' https://plausible.io https://formspree.io https://bat.bing.net https://bat.bing.com; form-action 'self'; upgrade-insecure-requests
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; frame-src https://calendly.com; script-src 'self' 'unsafe-inline' https://plausible.io https://bat.bing.net https://bat.bing.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://bat.bing.net https://bat.bing.com; font-src 'self'; connect-src 'self' https://plausible.io https://formspree.io https://bat.bing.net https://bat.bing.com; form-action 'self'

# Versioned assets: styles.css and /js/* are cache-busted via ?v=N (bump
# ASSET_VERSION + the page refs on every change — enforced convention), and
# /fonts/* files are renamed if their content ever changes. All three are
# therefore safe at max-age=1y immutable: the URL changes when the bytes do.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# shared JS is cache-busted via ?v=N in the pages that load it
/js/*
  Cache-Control: public, max-age=31536000, immutable

# EXCEPTION: /js/pa is the Plausible proxy shim and carries NO ?v= — it is a
# stable path whose bytes can change when the upstream script does, so the
# immutable rule above would pin a stale copy in every browser for a year.
# Listed after /js/* so this shorter cache wins.
/js/pa
  Cache-Control: public, max-age=3600, must-revalidate

# Blog search/teaser data — short cache, refreshed on every deploy
/blog-data/*
  Cache-Control: public, max-age=300
  Content-Type: application/json; charset=utf-8

/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

# Force classic favicon MIME (Cloudflare defaults .ico to image/vnd.microsoft.icon)
/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800

# GEO files — llms.txt (fact sheet), llms-full.txt (page text), facts.json
# (structured) for LLM/agent consumption; all regenerate from site-facts.json
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/facts.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# App icons
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800

/content/blog/*
  X-Robots-Tag: noindex, nofollow
