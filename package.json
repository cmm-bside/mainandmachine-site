{
  "name": "mainandmachine-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Main & Machine \u2014 static site with a build-time blog (The Ampersand) sourced from beehiiv.",
  "scripts": {
    "blog:fetch": "node scripts/fetch-blog-posts.mjs",
    "blog:build": "node scripts/build-blog.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "seo:dates": "node scripts/build-page-dates.mjs",
    "faq:inject": "node scripts/inject-faq.mjs",
    "facts:check": "node scripts/check-facts.mjs",
    "head:check": "node scripts/check-head.mjs",
    "llms:build": "node scripts/build-llms.mjs",
    "llms:check": "node scripts/check-llms.mjs",
    "facts:render": "node scripts/render-facts.mjs",
    "work:build": "node scripts/build-work.mjs",
    "testimonials:build": "node scripts/build-testimonials.mjs",
    "placeholders:check": "node scripts/check-placeholders.mjs",
    "links:check": "node scripts/check-internal-links.mjs",
    "og:build": "node scripts/build-og.mjs",
    "book:check": "node scripts/check-book.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "sweep:mobile": "node scripts/mobile-sweep.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:shots": "node scripts/screenshot-routes.mjs",
    "test:book": "node scripts/test-book-assessment.mjs",
    "build:static": "npm run blog:fetch && npm run blog:build && npm run facts:render && npm run llms:build && npm run work:build && npm run testimonials:build && npm run seo:check && npm run facts:check && npm run llms:check && npm run head:check && npm run tokens:check && npm run placeholders:check && npm run links:check && npm run book:check",
    "postinstall": "ALLOW_EMPTY_BLOG=1 node scripts/build-blog.mjs",
    "preview": "python3 -m http.server 8000",
    "tokens:check": "node scripts/check-tokens.mjs",
    "mono:check": "node scripts/check-mono.mjs",
    "qa:matrix": "node scripts/qa-matrix.mjs"
  },
  "dependencies": {
    "image-size": "^1.2.1",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1"
  }
}
