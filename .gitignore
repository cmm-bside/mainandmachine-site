# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# tooling
node_modules/
.wrangler/
.vercel/
.netlify/

# generated at build from beehiiv (npm run build:static) — never committed
src/data/blog-posts.js
blog-data/
blog/index.html
blog/rss.xml
blog/*/
images/blog/
sitemap.xml

# local email previews (generated by npm run test:book)
emails/preview/

# local scratch / verification artifacts — never committed
scratchpad/
audit/

# FUSE temp artifacts — stale duplicates that got committed once already
.fuse_hidden*

# Local scratch — never commit: Pages serves the repo root, so a stale copy of
# the site here would be published as duplicate content. These are the same
# dirs LOCAL_SCRATCH_DIRS makes the build guards skip.
_to_delete/
kobo_downloads/
.claude/
